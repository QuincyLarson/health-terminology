{
  "name": "health-terminology",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "validate:content": "node --import tsx scripts/validate-content.ts",
    "find-duplicates": "node --import tsx scripts/find-duplicates.ts",
    "generate-indices": "node --import tsx scripts/generate-indices.ts",
    "check": "npm run validate:content && npm run build"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3",
    "vite": "^7.0.0"
  }
}
